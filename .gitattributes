# Fuerza finales de linea LF en todo el repositorio.
#
# Sin esto, los archivos editados en Windows entran con CRLF y en Linux
# cada archivo aparece como modificado sin que haya ningun cambio real:
# el diff muestra todas las lineas borradas y agregadas otra vez.
# Ver README.md, seccion "Problema resuelto".
* text=auto eol=lf
# Los archivos de configuracion de Docker deben quedar exactos
Dockerfile        text eol=lf
docker-compose.yml text eol=lf
.dockerignore     text eol=lf
*.env             text eol=lf
*.sh              text eol=lf
*.sql             text eol=lf
# Los .sh tienen que ser ejecutables en Linux
*.sh text eol=lf
entrega/*.7z.00* filter=lfs diff=lfs merge=lfs -text

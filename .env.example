# =====================================================================
# TGS - Taller Global de Servicios
# PLANTILLA de configuracion (variables globales)
#
# Este archivo documenta TODAS las variables que el sistema reconoce.
# No edites este archivo para configurar tu maquina: copialo a .env
# y sobreescribi .env.local con lo que cambie en tu equipo.
#
#   .env        -> variables GLOBALES (versionadas, las usa todo el equipo)
#   .env.local  -> variables LOCALES  (NO versionadas, pisan a las globales)
#
# Precedencia:  .env.local  >  .env  >  valor por defecto en config.php
# =====================================================================

# --- Aplicacion -----------------------------------------------------
# Entorno de ejecucion: produccion | desarrollo
APP_ENV=produccion
# Muestra errores de PHP en pantalla: 1 = si, 0 = no
APP_DEBUG=0
# Puerto del host donde se publica la aplicacion (contenedor app)
APP_PUERTO=8080

# --- Base de datos --------------------------------------------------
# Host de MySQL. Dentro de Docker Compose el host es el nombre del
# servicio: "db". Si ejecutas con Apache nativo en el host, cambia a
# 127.0.0.1 en tu .env.local
DB_HOST=db
DB_NAME=bluetech_base
# Usuario de aplicacion (sin permisos administrativos)
DB_USER=tgs
DB_PASS=cambiar_en_tu_env_local
# Contrasena del usuario root de MySQL, usada solo por los scripts
DB_ROOT_PASS=cambiar_en_tu_env_local
DB_CHARSET=utf8mb4
DB_PUERTO=3306

# --- Respaldo de base de datos --------------------------------------
# Cantidad de respaldosautomaticos que se conservan antes de rotar
RESPALDO_CONSERVAR=5
